NODE_ENV=development
# development | qa | production — template generation (generationMode=false) allowed except production
APP_ENV=development
SERVICE_NAME=n0-project-service
SERVICE_VERSION=0.1.0
PORT=4001
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT=2mb
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
ENABLE_SWAGGER=true

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# AI orchestration (calls n0-ai-service — requires OPENAI_API_KEY in ai-service)
AI_SERVICE_URL=http://127.0.0.1:4003
AI_POLL_MS=400
AI_GENERATION_TIMEOUT_MS=300000
