    "/api/auth/oauth/{provider}/start": {
      "get": {
        "operationId": "AuthRoutesController_oauthStart",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "google",
                "github",
                "apple"
              ],
              "type": "string"
            }
          },
          {
            "name": "redirectTo",
            "required": false,
            "in": "query",
            "schema": {
              "example": "/dashboard",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success"
          }
        },
        "tags": [
          "auth"
        ]
      }
    },
    "/api/auth/oauth/{provider}/callback": {
      "get": {
        "operationId": "AuthRoutesController_oauthCallback",
        "parameters": [
          {
            "name": "provider",
            "required": true,
            "in": "path",
            "schema": {
              "enum": [
                "google",
                "github",
                "apple"
              ],
              "type": "string"
            }
          },
          {
            "name": "code",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "state",
            "required": true,
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
