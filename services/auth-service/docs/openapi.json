  "info": {
    "title": "n0-auth-service",
    "description": "N0 auth API",
    "version": "1.0"
  },
  "tags": [],
  "servers": [
    {
      "url": "http://localhost:4000",
      "description": "Local development"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "CheckEmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rahul@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rahul@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123"
          },
          "rememberMe": {
            "type": "boolean",
            "example": true,
            "default": true
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "SignupDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rahul@example.com"
          },
          "password": {
            "type": "string",
            "example": "Password123",
            "minLength": 8
          },
          "name": {
            "type": "string",
            "example": "Rahul Mukati"
          },
          "turnstileToken": {
            "type": "string",
            "example": "cloudflare_turnstile_token"
          }
        },
        "required": [
          "email",
          "password",
          "turnstileToken"
        ]
      },
      "VerifyHumanDto": {
        "type": "object",
        "properties": {
          "turnstileToken": {
            "type": "string",
            "example": "cloudflare_turnstile_token"
          }
        },
        "required": [
          "turnstileToken"
        ]
      },
      "EmailDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "rahul@example.com"
          }
        },
        "required": [
          "email"
        ]
      },
      "ConfirmEmailDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "email_verification_token"
          }
        },
        "required": [
          "token"
        ]
      },
      "RefreshSessionDto": {
        "type": "object",
        "properties": {
          "refreshToken": {
            "type": "string",
            "example": "refresh_token_here"
          }
        },
        "required": [
          "refreshToken"
        ]
      },
      "ResetPasswordDto": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "example": "password_reset_token"
          },
          "password": {
            "type": "string",
            "example": "NewPassword123",
            "minLength": 8
          }
        },
        "required": [
          "token",
          "password"
        ]
      },
      "ChangePasswordDto": {
        "type": "object",
        "properties": {
          "currentPassword": {
            "type": "string",
            "example": "OldPassword123"
          },
          "newPassword": {
            "type": "string",
            "example": "NewPassword123",
            "minLength": 8
          }
        },
        "required": [
          "currentPassword",
          "newPassword"
        ]
      },
      "OAuthExchangeDto": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "example": "oauth_state_or_code"
          }
        },
        "required": [
          "code"
        ]
      }
    }
  }
}