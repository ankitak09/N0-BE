NODE_ENV=development
SERVICE_NAME=n0-auth-service
SERVICE_VERSION=0.1.0
PORT=4000
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT=1mb
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
ENABLE_SWAGGER=true

DATABASE_URL=postgresql://noauth:noauth@localhost:5434/n0_platform?schema=public
TYPEORM_LOGGING=false

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=30
FRONTEND_URL=http://localhost:3000
# Optional: Cloudflare Turnstile secret (skipped in development when unset)
TURNSTILE_SECRET_KEY=

ENABLE_KAFKA=false
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=n0-auth-service
