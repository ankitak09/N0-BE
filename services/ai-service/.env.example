NODE_ENV=development
# development | qa | production — template generation allowed except production
APP_ENV=development
SERVICE_NAME=n0-ai-service
SERVICE_VERSION=0.1.0
PORT=4003
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT=2mb
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=100
ENABLE_SWAGGER=true

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# LLM provider when generationMode=true: auto | local | groq | ollama | openai
# auto = Groq if GROQ_API_KEY set, else OpenAI if keyed, else Ollama if running, else built-in generator
AI_PROVIDER=auto

# --- Recommended: Groq free cloud AI ---
# GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama-3.1-8b-instant
GROQ_TIMEOUT_MS=120000
GROQ_TLS_REJECT_UNAUTHORIZED=true

# --- Built-in generator only (no API key) ---
# AI_PROVIDER=local

# --- Ollama (local LLM) ---
# AI_PROVIDER=ollama
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_MS=300000

# --- OpenAI or compatible API ---
# OPENAI_API_KEY=sk-...
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_TIMEOUT_MS=180000

AI_FILE_WRITE_DELAY_MS=80
AI_GENERATED_OUTPUT_DIR=./generated
