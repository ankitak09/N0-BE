NODE_ENV=development
SERVICE_NAME=n0-api-gateway
SERVICE_VERSION=0.1.0
PORT=3001
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=1mb
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200
ENABLE_SWAGGER=true

# Must match auth-service
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# Internal upstreams (not exposed to the public internet in production)
AUTH_SERVICE_URL=http://127.0.0.1:4000
PROJECT_SERVICE_URL=http://127.0.0.1:4001
