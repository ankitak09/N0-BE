NODE_ENV=development
SERVICE_NAME=n0-api-gateway
SERVICE_VERSION=0.1.0
PORT=3001
# Comma-separated browser origins (dev allows any localhost port)
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:3000
BODY_LIMIT=1mb
TRUST_PROXY=false
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200
ENABLE_SWAGGER=true

# Must match auth-service
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars

# Internal upstreams (not exposed to the public internet in production)
AUTH_SERVICE_URL=http://127.0.0.1:4000
PROJECT_SERVICE_URL=http://127.0.0.1:4001

# Demo: allow FE to call /api/workspaces without JWT
ENABLE_DEMO_AUTH_BYPASS=true
PROJECT_SERVICE_URL=http://127.0.0.1:4001
AI_SERVICE_URL=http://127.0.0.1:4003
